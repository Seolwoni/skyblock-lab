{
  "schemaVersion": 1,
  "id": "marceline",
  "version": "${version}",
  "name": "Marceline",
  //#if CHEAT
  "description": "SkyBlock toolkit for @MINECRAFT_VERSION@: fishing, dungeons and routes in one clean menu.\nOpen with /mar. Built on NoammAddons (CC0) and Secret Routes (GPL-3.0).",
  //#else
  //!"description": "SkyBlock toolkit for @MINECRAFT_VERSION@: dungeons, fishing helpers and routes in one clean menu (legit build).\nOpen with /mar. Built on NoammAddons (CC0) and Secret Routes (GPL-3.0).",
  //#endif
  "authors": [
    "seolwoni"
  ],
  "contributors": [
    "Noamm - NoammAddons, the base (CC0)",
    "yourboykyle - Secret Routes (GPL-3.0)"
  ],
  "license": ["CC0-1.0", "GPL-3.0-only"],
  "icon": "assets/marceline/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "dev.marceline.ui.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "value": "dev.marceline.Marceline",
        "adapter": "kotlin"
      },
      "xyz.yourboykyle.secretroutes.Main"
    ]
  },
  "mixins": [
    "marceline.mixins.json",
    "secretroutes.mixins.json"
  ],
  "accessWidener": "marceline.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "@MINECRAFT_VERSION@",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "suggests": {
    "assistcore": "*",
    "assistpath": "*"
  }
}