{
  "schemaVersion": 1,
  "id": "noammaddons",
  "version": "${version}",
  "name": "Riftwalk",
  //#if CHEAT
  "description": "SkyBlock toolkit for @MINECRAFT_VERSION@: fishing, dungeons and routes in one clean menu.\nOpen with /rw. Built on NoammAddons (CC0) and Secret Routes (GPL-3.0).",
  //#else
  //!"description": "SkyBlock toolkit for @MINECRAFT_VERSION@: dungeons, fishing helpers and routes in one clean menu (legit build).\nOpen with /rw. Built on NoammAddons (CC0) and Secret Routes (GPL-3.0).",
  //#endif
  "authors": [
    "Noamm"
  ],
  "contact": {
    "homepage": "https://github.com/Noamm9",
    "sources": "https://github.com/Noamm9/NoammAddons",
    "issues": "https://github.com/Noamm9/NoammAddons/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/noammaddons/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "dev.riftwalk.ui.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "value": "dev.riftwalk.Riftwalk",
        "adapter": "kotlin"
      },
      "xyz.yourboykyle.secretroutes.Main"
    ]
  },
  "mixins": [
    "noammaddons.mixins.json",
    "secretroutes.mixins.json"
  ],
  "accessWidener": "noammaddons.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "@MINECRAFT_VERSION@",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "suggests": {
    "assistcore": "*",
    "assistpath": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Discord": "https://discord.com/invite/pj9mQGxMxB"
      }
    }
  }
}